# Backend repository allowlist. Everything else in the local delivery stays local.
/*
!/.gitignore
!/.env.example
!/README.md
!/AGENTS.md
!/ONBOARDING.md
!/package.json
!/package-lock.json
!/apps/
/apps/*
!/apps/server/
!/apps/client/
/apps/client/*
!/apps/client/README.md
!/apps/client/web/
/apps/client/web/SZH_assets/fonts/NotoSansSC.ttf
!/apps/client/workbench/
/apps/client/workbench/*
!/apps/client/workbench/src/
/apps/client/workbench/src/*
!/apps/client/workbench/src/aic-files.json
!/apps/szh-app/
/apps/szh-app/captures/
/apps/szh-app/release/
!/Start-SZH-Next.cmd
!/docs/
/docs/*
!/docs/README.md
!/docs/engineering/
!/docs/harness/
/docs/engineering/*
!/docs/engineering/*.md
/docs/harness/*
!/docs/harness/*.md
!/contracts/
!/evaluation/
/evaluation/*
!/evaluation/notam-cases.json
!/evaluation/report-cases.json
!/knowledge/
/knowledge/documents/
!/plugins/
!/scripts/
/scripts/aic/*
!/scripts/aic/run_solution.py
!/solutions/
!/tests/

# Defense in depth inside allowlisted folders.
node_modules/
dist/
dist-electron/
__pycache__/
coverage/
.env
.env.*
!/.env.example
*.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.log
*.tmp
*.sqlite*
*.db
*.zstd
*.zip
*.tar
*.gz
*.7z
*.pdf
*.pt
*.pth
*.safetensors
*.onnx
*.npz
*.npy
*.h5
*.exe
*.dll
